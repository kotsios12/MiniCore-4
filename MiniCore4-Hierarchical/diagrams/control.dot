digraph CTRL { graph [rankdir=LR,bgcolor="#0b1220",label="CONTROL | Single-cycle Instruction Decode",labelloc=t,fontcolor=white,fontsize=22,pad=0.3]; node [shape=box,style="rounded,filled",fillcolor="#17263c",color="#4b779c",fontcolor=white,fontsize=14]; edge [color="#a9c4e0",fontcolor=white]; ir [label="Instruction [7:0]"]; dec [label="Opcode Decoder"]; flags [label="Z / C flags"]; control [label="Control Logic"]; pc [label="PC: Increment / Jump"]; regs [label="ACC / B enables"]; mem [label="RAM read / write"]; out [label="OUT / HLT"]; ir->dec; dec->control; flags->control; control->pc; control->regs; control->mem; control->out; }