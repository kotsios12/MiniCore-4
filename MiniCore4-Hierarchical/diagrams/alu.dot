digraph ALU { graph [rankdir=LR,bgcolor="#0b1220",label="4-BIT ALU | Arithmetic and Logic",labelloc=t,fontcolor=white,fontsize=22,pad=0.3]; node [shape=box,style="rounded,filled",fillcolor="#17263c",color="#4b779c",fontcolor=white,fontsize=14]; edge [color="#a9c4e0",fontcolor=white]; a [label="A [3:0]"]; b [label="B [3:0]"]; op [label="ALU op [2:0]"]; add [label="Ripple Adder 4\nADD / SUB"]; logic [label="Bitwise Logic\nAND / OR / XOR / NOT"]; mux [label="Result Selector"]; flags [label="Carry / Zero"]; result [label="RESULT [3:0]"]; a->add; b->add; a->logic; b->logic; op->add; op->logic; op->mux; add->mux; logic->mux; mux->result; mux->flags; add->flags; }